# Disable directory listing and MultiViews to prevent routing conflicts
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Prevent Apache mod_dir from redirecting directories with trailing slashes
  DirectorySlash Off

  # 1. Allow existing physical files through (CSS, JS, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Allow Next.js internal static assets through
  RewriteRule ^_next/ - [L]

  # 3. MATCH EXACT .HTML FILES FOR STATIC ROUTES:
  # E.g. /login -> login.html, /admin/courses -> admin/courses.html, /admin/appointments/new -> admin/appointments/new.html
  RewriteCond %{REQUEST_URI} ^/(.*?)/?$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^ /%1.html [L]

  RewriteCond %{REQUEST_FILENAME} ^(.*?)/?$
  RewriteCond %1.html -f
  RewriteRule ^(.*?)/?$ $1.html [L]

  # 4. DYNAMIC EDIT ROUTE MATCH:
  # E.g. /admin/appointments/<id>/edit -> /admin/appointments/placeholder/edit.html
  RewriteCond %{REQUEST_URI} ^/(.+)/[^/]+/edit/?$
  RewriteCond %{DOCUMENT_ROOT}/%1/placeholder/edit.html -f
  RewriteRule ^ /%1/placeholder/edit.html [L]

  RewriteCond %{REQUEST_FILENAME} ^(.*)/[^/]+/edit/?$
  RewriteCond %1/placeholder/edit.html -f
  RewriteRule ^(.*)/[^/]+/edit/?$ $1/placeholder/edit.html [L]

  # 5. DYNAMIC DETAIL ROUTE MATCH:
  # E.g. /admin/appointments/<id> -> /admin/appointments/placeholder.html
  RewriteCond %{REQUEST_URI} ^/(.+)/[^/]+/?$
  RewriteCond %{DOCUMENT_ROOT}/%1/placeholder.html -f
  RewriteRule ^ /%1/placeholder.html [L]

  RewriteCond %{REQUEST_FILENAME} ^(.*)/[^/]+/?$
  RewriteCond %1/placeholder.html -f
  RewriteRule ^(.*)/[^/]+/?$ $1/placeholder.html [L]

  # 6. SPA FALLBACK: If not a physical file or dynamic placeholder, fallback to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.html [L]
</IfModule>

# 7. Error handling
ErrorDocument 404 /404.html